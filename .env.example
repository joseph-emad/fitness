POSTGRES_DB=fitness_user_db
POSTGRES_USER=fitness
POSTGRES_PASSWORD=fitness_local

RABBITMQ_USERNAME=fitness
RABBITMQ_PASSWORD=fitness_local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local
# Issuer URL advertised in Keycloak tokens. For physical-device development, set this
# to a LAN-reachable hostname/IP and use the exact same URL in the mobile app config.
KEYCLOAK_PUBLIC_URL=http://localhost:8181

# Optional: provide a real key to enable AI recommendations.
GEMINI_API_KEY=

# MongoDB must run as a replica set for the activity service's transactional outbox.
# The Compose stack initializes a local single-node replica set automatically.
