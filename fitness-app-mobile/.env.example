# For Android emulator, use http://10.0.2.2:8080/api and http://10.0.2.2:8181.
# For a physical device, use the development computer's LAN-reachable hostname/IP.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_KEYCLOAK_URL=http://localhost:8181
EXPO_PUBLIC_KEYCLOAK_REALM=fitness-oauth2
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=fitness-mobile

# Local HTTP is enabled only in explicit local development builds.
EXPO_PUBLIC_ALLOW_INSECURE_HTTP=true
