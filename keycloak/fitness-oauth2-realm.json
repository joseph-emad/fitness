{
  "realm": "fitness-oauth2",
  "enabled": true,
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "oauth2-pkce-client",
      "name": "Fitness frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "fitness-mobile",
      "name": "Fitness mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "fitness-mobile://oauth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "fitness-mobile://oauth/callback"
      }
    }
  ]
}
